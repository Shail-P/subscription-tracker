{
  "name": "subscription-tracker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A desktop subscription tracker built with Electron, React, and Supabase.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@supabase/supabase-js": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
